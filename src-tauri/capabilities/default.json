{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:image:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "core:window:allow-is-resizable",
    "core:window:allow-set-resizable",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "shell:allow-open",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "core:path:allow-join",
    "fs:allow-create",
    "fs:allow-copy-file",
    "fs:allow-exists",
    "fs:allow-fstat",
    "fs:allow-ftruncate",
    "fs:allow-lstat",
    "fs:allow-mkdir",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-watch",
    "fs:allow-write",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:read-all",
    "fs:read-dirs",
    "fs:read-files",
    "fs:read-meta",
    "fs:scope",
    "fs:write-all",
    "fs:write-files",
    "fs:allow-home-meta-recursive",
    "fs:allow-home-write-recursive",
    "fs:scope-home-recursive",
    "dialog:default",
    "dialog:allow-open",
    "log:default",
    "log:allow-log",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen"
  ]
}