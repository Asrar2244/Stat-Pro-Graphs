{
  "productName": "Stat-Pro",
  "version": "1.2.7",
  "identifier": "com.stat.pro",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "capabilities": [],
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": false,
      "pattern": {
        "use": "brownfield"
      }
    },
    "windows": [
      {
        "title": "Stat-Pro",
        "height": 800,
        "visible": false,
        "label": "main",
        "resizable": true,
        "fullscreen": false,
        "skipTaskbar": false,
        "maximized": true,
        "decorations": true,
        "alwaysOnTop": false,
        "width": 900,
        "transparent": true
      },
      {
        "title": "Stat-Pro",
        "width": 450,
        "height": 300,
        "url": "/splash-screen/splash.html",
        "label": "splashscreen",
        "center": true,
        "decorations": false,
        "resizable": false,
        "dragDropEnabled": false,
        "visible": true
      }
    ]
  },
  "bundle": {
    "resources": [
      "backend"
    ],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}