{
  "productName": "start-pro",
  "version": "0.0.0",
  "identifier": "com.start.pro",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "start-pro",
        "width": 800,
        "height": 800,
        "visible": false,
        "label": "main",
        "resizable": true,
        "fullscreen": false,
        "skipTaskbar": false,
        "decorations": true,
        "alwaysOnTop": false
   
      },
      {
        "title": "start-pro",
        "width": 450,
        "height": 300,
        "url": "/splash-screen/splash.html",
        "label": "splashscreen",
        "center": true,
        "decorations": false
 
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
