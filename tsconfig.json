{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [ "ES2020", "DOM", "DOM.Iterable" ],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noImplicitThis": false,
    "noPropertyAccessFromIndexSignature": false,
    "ignoreDeprecations": "5.0",
    "suppressImplicitAnyIndexErrors": true,
    "noUncheckedIndexedAccess": false,

    /* Alias Path */
    "baseUrl": ".",
    "paths": {
      "@libs/*": [ "src/libs/*" ],
      "@libs": [ "src/libs" ],
      "@constants/*": [ "src/constants/*" ],
      "@constants": [ "src/constants" ],
      "@backend/*": [ "src/backend/*" ],
      "@backend": [ "src/backend" ],
      "@utils/*": [ "src/utils/*" ],
      "@utils": [ "src/utils" ],
      "@store/*": [ "src/store/*" ],
      "@store": [ "src/store" ],
      "@hooks/*": [ "src/hooks/*" ],
      "@hooks": [ "src/hooks" ],
      "@workers/*": [ "src/workers/*" ],
      "@workers": [ "src/workers" ],
      "@context": [ "src/screens/output-render/context" ],
      "@outputStyles/*": [ "src/screens/output-render/styles-hook/*" ],
      "@outputStyles": [ "src/screens/output-render/styles-hook" ],
      "@outputRegressionCommon/*": [ "src/screens/output-render/analyze/regression/common/*" ],
      "@outputRegressionCommon": [ "src/screens/output-render/analyze/regression/common" ],
      "@outputPrintReport/*": [ "src/screens/output-render/print-report/*" ],
      "@outputPrintReport": [ "src/screens/output-render/print-report" ]
    }
  },
  "include": [ "src" ],
  "exclude": [
    "src/screens/graphs-render-backup-20251020_090308",
    "node_modules"
  ],
  "references": [ { "path": "./tsconfig.node.json" } ]
}
